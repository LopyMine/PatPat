{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/${mod_id}",
		"sources": "https://github.com/${github_mod_author}/${mod_id}",
		"issues": "https://github.com/${github_mod_author}/${mod_id}/issues"
	},
	"license": "${mod_license}",
	"icon": "icon.png",
	"environment": "${fabric_trick_side}",
	"entrypoints": {
		"main": [
			"net.lopymine.patpat.entrypoint.impl.fabric.FabricCommonEntrypoint"
		],
		"client": [
			"net.lopymine.patpat.entrypoint.impl.fabric.FabricClientEntrypoint"
		],
		"server": [
			"net.lopymine.patpat.entrypoint.impl.fabric.FabricDedicatedEntrypoint"
		],
		"modmenu": [
			"net.lopymine.patpat.modmenu.integration.PatPatModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=${fabric_loader}",
		"minecraft": ">=${minecraft}",
		"java": ">=${java}",
		"${fabric_api_id}": "*"
	},
	"accessWidener": "${fabric_trick_accesswidener_id}",
	"mixins": [
		"${fabric_trick_mixin_configs}"
	],
	"custom": {
		"translators": {
			"MrLemonHog": "Українська (Україна) (100%)",
			"Nuts": "Español (España) (100%)",
			"Baymaxawa": "简体中文 (中国大陆) (100%)",
			"alinco8": "日本語 (日本) (99%)",
			"TastyPommesLul, Clemens Schmidt": "Deutsch (Deutschland) (97%)",
			"Hamka": "Polski (Polska) (90%)",
			"승수": "한국어 (대한민국) (41%)",
			"Balojan": "Tiếng Việt (Việt Nam) (42%)",
			"Gallium, Matt TCL": "Français (France) (28%)",
			"hectorg22": "Português (Brasil) (23%)",
			"okunamayanad": "Türkçe (Türkiye) (23%)",
			"Valdemras “a game” Chacha": "Lietuvių (Lietuva) (21%)"
		},
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/NZzxdkrV4s",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/${mod_id}",
				"modmenu.modrinth": "https://modrinth.com/mod/${mod_id}",
				"Weblate": "https://weblate.nik51.name/projects/${mod_id}"
			},

			"update_checker": true
		}
	}
}